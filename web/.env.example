# Neon (Postgres). Use the -pooler host: serverless functions open and drop
# connections constantly and would exhaust the direct endpoint's limit.
DATABASE_URL=

# CallTrackingMetrics -- needed only by /api/login-exact, which queries an
# exact window on demand because login_time cannot be derived from stored
# hourly data. Same values as the sync job's .env.local.
CTM_API_HOST=https://api.calltrackingmetrics.com
CTM_ACCESS_KEY=
CTM_SECRET_KEY=
CTM_ACCOUNT_ID=

# Shared password for the whole dashboard.
DASHBOARD_PASSWORD=

# Secret used to sign the session cookie. Any long random string; changing it
# invalidates every existing session. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
